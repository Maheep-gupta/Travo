# Copy to apps/connector/.env. Never put a secret / service-role key here.

# Your Supabase project (local: http://127.0.0.1:54321 from `npm run db:status`).
MC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key only (sb_publishable_...). Secret keys are rejected.
MC_SUPABASE_PUBLISHABLE_KEY=

# mock = simulated demo sessions. claude-code is disabled in this build until
# the database isolation tests have passed.
MC_PROVIDER=mock
MC_POLL_MS=5000
MC_DATA_DIR=.data

# Transcript excerpts are only ever written to a loopback (on-this-laptop)
# database, even when enabled.
MC_SYNC_TRANSCRIPTS=false
